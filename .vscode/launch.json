{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ctrlloop: step through main",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["${input:originalRequest}"],
      "stopOnEntry": true,
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "originalRequest",
      "type": "promptString",
      "description": "Original request to select a window and control for",
      "default": "open my hermes agent"
    }
  ]
}
